+                gemm_fold_launch_u2(false, gc, stream, W16, X16 + n0*K, cs + n0, Y + n0*sy, (int) M, (int) nc, (int) K, sy, nullptr, nullptr, 0, 0);
             } else {
                 gemm_fold_kernel<128, true><<<gc, 256, 0, stream>>>(W16, X16 + n0*K, cs + n0, Y + n0*sy, M, (int) nc, K, sy, nullptr);
